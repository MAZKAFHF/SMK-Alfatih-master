APP_NAME="SMK Tahfizh Al-Fatih"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

DEMO_ADMIN_EMAIL=admin@smkalfatih.sch.id
DEMO_ADMIN_PASSWORD=admin1234
# DEMO LOGIN DISABLED AUTOMATICALLY WHEN APP_ENV=production — set empty in production or leave unset
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=false
# For production behind HTTPS, set to true:
# SESSION_SECURE_COOKIE=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=3
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_BACKUP_ENABLED=true
APP_BACKUP_DIR=
APP_BACKUP_RETENTION=14
APP_BACKUP_DAILY_AT=02:00

LOG_RETENTION_ENABLED=true
DATABASE_LOG_RETENTION_DAYS=3
LOG_PRUNE_BATCH_SIZE=1000
LOG_PRUNE_DAILY_AT=03:00
TRASH_PURGE_ENABLED=true
TRASH_RETENTION_DAYS=7
TRASH_PURGE_BATCH_SIZE=100
TRASH_PURGE_DAILY_AT=03:15
TRASH_PURGE_CONTACT_MESSAGES=true
APPLICANT_CLEANUP_ENABLED=true
APPLICANT_ORPHAN_CLEANUP_ENABLED=true
APPLICANT_ORPHAN_RETENTION_DAYS=3
APPLICANT_VERIFIED_UNUSED_CLEANUP_ENABLED=true
APPLICANT_VERIFIED_UNUSED_RETENTION_DAYS=180
# Real applicants still require a completed period (archived + results released +
# operational completed). Per-period account_retention_until wins; otherwise the
# fallback below applies after operational completion.
APPLICANT_LIFECYCLE_CLEANUP_ENABLED=true
APPLICANT_REAL_RETENTION_DAYS=90
APPLICANT_RETIREMENT_BATCH_SIZE=100
APPLICANT_RETIREMENT_DAILY_AT=03:30

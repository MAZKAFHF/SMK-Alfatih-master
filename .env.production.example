APP_NAME="SMK Tahfizh Al-Fatih"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://smkalfatih.sch.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Leave empty in production — demo login auto-disabled when APP_ENV=production
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=true

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=3
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smkalfatih
DB_USERNAME=smk_user
DB_PASSWORD=change_me

# Or keep sqlite if host supports:
# DB_CONNECTION=sqlite
# DB_DATABASE=/path/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Resend API mailer. Aktifkan setelah domain pengirim terverifikasi.
MAIL_MAILER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM_ADDRESS="noreply@smkalfatih.sch.id"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="info@smkalfatih.sch.id"
MAIL_REPLY_TO_NAME="Admin SMK Tahfizh Al-Fatih"

VITE_APP_NAME="${APP_NAME}"

# Use an encrypted/off-site mounted directory outside the web root.
APP_BACKUP_ENABLED=true
APP_BACKUP_DIR=/mnt/backup-encrypted/smk-alfatih
APP_BACKUP_RETENTION=14
APP_BACKUP_DAILY_AT=02:00

LOG_RETENTION_ENABLED=true
DATABASE_LOG_RETENTION_DAYS=3
LOG_PRUNE_BATCH_SIZE=1000
LOG_PRUNE_DAILY_AT=03:00
TRASH_PURGE_ENABLED=true
TRASH_RETENTION_DAYS=7
TRASH_PURGE_BATCH_SIZE=100
TRASH_PURGE_DAILY_AT=03:15
TRASH_PURGE_CONTACT_MESSAGES=true
APPLICANT_CLEANUP_ENABLED=true
APPLICANT_ORPHAN_CLEANUP_ENABLED=true
APPLICANT_ORPHAN_RETENTION_DAYS=3
APPLICANT_VERIFIED_UNUSED_CLEANUP_ENABLED=true
APPLICANT_VERIFIED_UNUSED_RETENTION_DAYS=180
# Real applicants still require an explicit per-period retention deadline.
APPLICANT_LIFECYCLE_CLEANUP_ENABLED=true
APPLICANT_RETIREMENT_BATCH_SIZE=100
APPLICANT_RETIREMENT_DAILY_AT=03:30

APP_NAME="SMK Tahfizh Al-Fatih"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://smkalfatih.sch.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Leave empty in production — demo login auto-disabled when APP_ENV=production
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=true

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smkalfatih
DB_USERNAME=smk_user
DB_PASSWORD=change_me

# Or keep sqlite if host supports:
# DB_CONNECTION=sqlite
# DB_DATABASE=/path/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@smkalfatih.sch.id
MAIL_PASSWORD=change_me
MAIL_FROM_ADDRESS="noreply@smkalfatih.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
